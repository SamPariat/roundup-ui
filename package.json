{
  "name": "roundup-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @roundup/app run dev",
    "web": "pnpm --filter @roundup/app run web",
    "ios": "pnpm --filter @roundup/app run ios",
    "android": "pnpm --filter @roundup/app run android",
    "lint": "eslint . --max-warnings=0",
    "fmt": "prettier --write .",
    "fmt-check": "prettier --check .",
    "typecheck": "pnpm -r --parallel run typecheck && tsc --noEmit",
    "test": "pnpm -r --parallel run test",
    "tokens": "pnpm --filter @roundup/tokens run generate",
    "knip": "APP_ENV=beta knip",
    "syncpack": "syncpack lint",
    "files": "node scripts/check-files.ts",
    "doctor": "pnpm --filter @roundup/app run doctor"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@roundup/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "syncpack": "catalog:",
    "typescript": "catalog:"
  }
}
