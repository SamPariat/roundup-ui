{
  "name": "@roundup/app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/onest": "catalog:",
    "@expo/metro-runtime": "catalog:",
    "@react-native-async-storage/async-storage": "catalog:",
    "@roundup/i18n": "workspace:*",
    "@roundup/tokens": "workspace:*",
    "@roundup/ui": "workspace:*",
    "babel-preset-expo": "catalog:",
    "expo": "catalog:",
    "expo-constants": "catalog:",
    "expo-font": "catalog:",
    "expo-glass-effect": "catalog:",
    "expo-linking": "catalog:",
    "expo-localization": "catalog:",
    "expo-router": "catalog:",
    "expo-splash-screen": "catalog:",
    "expo-status-bar": "catalog:",
    "expo-system-ui": "catalog:",
    "nativewind": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-css": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-web": "catalog:",
    "react-native-worklets": "catalog:"
  },
  "devDependencies": {
    "@roundup/config": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "expo-doctor": "catalog:",
    "jest": "catalog:",
    "jest-expo": "catalog:",
    "lightningcss": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "test-renderer": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "dev": "APP_ENV=${APP_ENV:-beta} expo start",
    "web": "APP_ENV=${APP_ENV:-beta} expo start --web",
    "ios": "APP_ENV=${APP_ENV:-beta} expo start --ios",
    "android": "APP_ENV=${APP_ENV:-beta} expo start --android",
    "export:web": "APP_ENV=${APP_ENV:-beta} expo export --platform web",
    "doctor": "APP_ENV=${APP_ENV:-beta} expo install --check && APP_ENV=${APP_ENV:-beta} expo-doctor",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage"
  }
}
