# ── Node / pnpm ──────────────────────────────────────────────
**/node_modules/
**/.pnpm-debug.log
**/*.tsbuildinfo

# ── Build output ─────────────────────────────────────────────
**/dist/
**/build/

# ── Expo / React Native ──────────────────────────────────────
**/.expo/
**/.expo-shared/
**/expo-env.d.ts
**/ios/
**/android/
**/*.orig.*
**/web-build/
**/*.p8
**/*.p12
**/*.key
**/*.mobileprovision

# ── Environment files ────────────────────────────────────────
# Real env files (.env.beta, .env.prod) hold secrets and stay local.
# Only the *.example templates are committed.
**/.env
**/.env.*
!**/.env.*.example

# ── Docker local override ────────────────────────────────────
docker-compose.override.yml

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ── IDE ──────────────────────────────────────────────────────
# Editor settings are personal and stay local.
.vscode/
.idea/
*.iml

# ── Logs ─────────────────────────────────────────────────────
**/*.log
**/logs/

# Generated from assets/svg/logo/mark-dark.svg by scripts/copy-favicon.ts
apps/app/public/favicon.svg
