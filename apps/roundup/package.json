{
  "name": "@roundup/roundup",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/onest": "catalog:",
    "@expo/metro-runtime": "catalog:",
    "@react-native-async-storage/async-storage": "catalog:",
    "@roundup/i18n": "workspace:*",
    "@roundup/ui": "workspace:*",
    "babel-preset-expo": "catalog:",
    "expo": "catalog:",
    "expo-constants": "catalog:",
    "expo-font": "catalog:",
    "expo-glass-effect": "catalog:",
    "expo-linking": "catalog:",
    "expo-localization": "catalog:",
    "expo-router": "catalog:",
    "expo-splash-screen": "catalog:",
    "expo-status-bar": "catalog:",
    "expo-system-ui": "catalog:",
    "nativewind": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-css": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-web": "catalog:",
    "react-native-worklets": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "expo-doctor": "catalog:",
    "jest": "catalog:",
    "jest-expo": "catalog:",
    "lightningcss": "catalog:",
    "postcss": "catalog:",
    "react-native-svg-transformer": "catalog:",
    "tailwindcss": "catalog:",
    "test-renderer": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "favicon": "../../scripts/copy-favicon.sh",
    "dev": "pnpm run favicon && ../../scripts/with-env.sh expo start",
    "web": "pnpm run favicon && ../../scripts/with-env.sh expo start --web",
    "ios": "pnpm run favicon && ../../scripts/with-env.sh expo start --ios",
    "android": "pnpm run favicon && ../../scripts/with-env.sh expo start --android",
    "export:web": "pnpm run favicon && ../../scripts/with-env.sh expo export --platform web",
    "doctor": "../../scripts/with-env.sh expo install --check && ../../scripts/with-env.sh expo-doctor",
    "routes": "CI=1 ../../scripts/with-env.sh expo customize tsconfig.json",
    "typecheck": "pnpm run routes && tsc --noEmit",
    "test": "jest"
  }
}
