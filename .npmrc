# Fail on a Node that does not match "engines" in package.json.
engine-strict=true
# A missing or mismatched peer dependency is an error, not a warning.
strict-peer-dependencies=true
# Peers are installed by the package that needs them, never guessed.
auto-install-peers=false
# New dependencies are saved as exact versions, never ^ or ~ ranges (syncpack enforces it).
save-exact=true
