    "typescript": "catalog:"
  },
  "scripts": {
    "web": "expo start --web",
    "dev": "expo start --dev-client",
    "prebuild:ios": "EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform ios",
    "prebuild:android": "EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform android",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "export:web": "expo export --platform web",
    "doctor": "expo install --check && expo-doctor",
    "routes": "CI=1 expo customize tsconfig.json",
    "typecheck": "pnpm run routes && tsc --noEmit",
    "test": "jest"
  }
