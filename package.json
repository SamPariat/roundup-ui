{
  "name": "roundup-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @roundup/roundup run dev",
    "web": "pnpm --filter @roundup/roundup run web",
    "prebuild:ios": "pnpm --filter @roundup/roundup run prebuild:ios",
    "prebuild:android": "pnpm --filter @roundup/roundup run prebuild:android",
    "ios": "pnpm --filter @roundup/roundup run ios",
    "android": "pnpm --filter @roundup/roundup run android",
    "catalog": "pnpm --filter @roundup/catalog run web",
    "prebuild:catalog:ios": "pnpm --filter @roundup/catalog run prebuild:ios",
    "prebuild:catalog:android": "pnpm --filter @roundup/catalog run prebuild:android",
    "catalog:ios": "pnpm --filter @roundup/catalog run ios",
    "catalog:android": "pnpm --filter @roundup/catalog run android",
    "lint": "eslint . --max-warnings=0 && pnpm run lint:sh",
    "lint:sh": "shellcheck scripts/*.sh .githooks/*",
    "fmt": "prettier --write .",
    "fmt-check": "prettier --check .",
    "typecheck": "pnpm -r --parallel run typecheck && tsc --noEmit",
    "test": "pnpm -r --parallel run test",
    "knip": "APP_ENV=beta knip",
    "syncpack": "syncpack lint",
    "files": "scripts/check-files.sh",
    "doctor": "pnpm --filter @roundup/roundup run doctor && pnpm --filter @roundup/catalog run doctor",
    "updates": "scripts/check-updates.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:",
    "@eslint-react/eslint-plugin": "catalog:",
    "@eslint/compat": "catalog:",
    "@eslint/js": "catalog:",
    "@stylistic/eslint-plugin": "catalog:",
    "@svgr/core": "catalog:",
    "@svgr/plugin-jsx": "catalog:",
    "@types/node": "catalog:",
    "babel-jest": "catalog:",
    "babel-preset-expo": "catalog:",
    "eslint": "catalog:",
    "eslint-config-expo": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "eslint-plugin-i18next": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-jest": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-native": "catalog:",
    "eslint-plugin-react-native-a11y": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "eslint-plugin-testing-library": "catalog:",
    "eslint-plugin-unicorn": "catalog:",
    "expo": "catalog:",
    "globals": "catalog:",
    "jest": "catalog:",
    "jest-expo": "catalog:",
    "jiti": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "syncpack": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
