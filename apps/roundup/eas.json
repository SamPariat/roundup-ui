{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "image": "latest", "simulator": true },
      "env": { "APP_ENV": "beta" }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "image": "latest" },
      "env": { "APP_ENV": "beta" }
    },
    "production": {
      "autoIncrement": true,
      "ios": { "image": "latest" },
      "env": { "APP_ENV": "prod" }
    }
  }
}
